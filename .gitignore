node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment — never commit
.env
.env.*
!.env.example

# SQLite database files (local persistent storage). The DB is created at
# runtime by start.sh / prisma; it must NEVER be committed to git.
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Auto-generated JWT secret fallback (persistent, server-local, chmod 600).
# It is a SECRET — never commit it.
data/.jwt_secret

# YouTube cookies for the profile-music feature (anti-bot). A cookie jar is a
# CREDENTIAL (it authenticates a logged-in session) — never commit it, and
# never commit the temporary jars the server writes per run.
data/cookies.txt
data/.yt-cookies-*

# Binários baixados pelo start.sh (yt-dlp/ffmpeg estáticos). São executáveis
# de terceiros, grandes (~40MB e ~150MB) — nunca vão para o git; cada host os
# baixa e confere o SHA-256 no primeiro boot.
data/bin/

# Local upload storage (dev). Note: anchored to repo root so it does NOT
# ignore the source module at src/modules/uploads/.
/uploads/

# Prisma generated client
src/generated/

# SQLite DB files under prisma (dev/test local storage)
prisma/data/

# Pid/logs
*.pid
*.log
