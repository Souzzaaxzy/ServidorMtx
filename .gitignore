node_modules/
dist/
coverage/
*.tsbuildinfo

# Environment — never commit
.env
.env.*
!.env.example

# SQLite database files (local persistent storage). The DB is created at
# runtime by start.sh / prisma; it must NEVER be committed to git.
data/*.db
data/*.db-journal
data/*.db-shm
data/*.db-wal

# Auto-generated JWT secret fallback (persistent, server-local, chmod 600).
# It is a SECRET — never commit it.
data/.jwt_secret

# Local upload storage (dev). Note: anchored to repo root so it does NOT
# ignore the source module at src/modules/uploads/.
/uploads/

# Prisma generated client
src/generated/

# SQLite DB files under prisma (dev/test local storage)
prisma/data/

# Pid/logs
*.pid
*.log
