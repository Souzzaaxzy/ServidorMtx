// MATRIX 💤 — database schema (Prisma)
// See migrations/ for the versioned history.
//
// Design principles (Phase 3):
// - Identity: internal `id` (cuid) never changes; `username` is mutable.
//   All relations use `userId`/`id`, never `username`.
// - No email/phone: auth is username + password only.
// - Password hashing uses Argon2id; recovery codes are hashed too.
// - Gamification: XP and Matrix Coins are append-only ledgers
//   (xp_transactions / coin_transactions) for full auditability.
// - Customization: the APK renders generic item "types"; the server owns
//   which items exist, their rarity, pricing and availability. Adding a new
//   frame/banner/badge never requires a new APK.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated"
}

datasource db {
  provider = "sqlite"
  // SQLite file lives at <project root>/data/matrix.db (see scripts/start.sh,
  // which creates data/ on boot). DATABASE_URL is optional in production: if
  // the panel does not set it, the app/start.sh default to this file path.
  // Tests override DATABASE_URL to point at a throwaway file (see .env.test).
  url      = env("DATABASE_URL")
}

// NOTE: Prisma's SQLite connector does not support `enum` types, so these
// are stored as plain `String` columns. The allowed values are mirrored as
// TypeScript const enums in src/types/enums.ts and validated at the app
// layer. Defaults below keep the same value names the codebase already uses.

model User {
  id               String   @id @default(cuid())
  // Single visual identity (Phase 5): only `nickname`. Legacy `name`/
  // `username` were merged by the 20260826_unify_identity_nickname migration.
  // The display form is stored EXACTLY as typed (Unicode, emojis, mixed
  // case). `nicknameKey` is the case-insensitive lookup key (lowercased
  // display form) that powers uniqueness, login, recovery and profile
  // resolution — "Leonardo" and "LEONARDO" cannot coexist.
  nickname         String   @unique
  nicknameKey      String   @unique @default("")
  passwordHash     String
  recoveryCodeHash String
  role             String   @default("USER")
  avatarUrl        String?
  bio              String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  posts        Post[]
  likes        Like[]
  comments     Comment[]
  commentLikes CommentLike[]
  sessions     Session[]
  devices      Device[]

  sentFriendRequests     FriendRequest[] @relation("sentFriendRequests")
  receivedFriendRequests FriendRequest[] @relation("receivedFriendRequests")
  friendshipOnes         Friendship[]    @relation("friendshipOne")
  friendshipTwos         Friendship[]    @relation("friendshipTwo")

  conversationOnes      Conversation[] @relation("conversationOne")
  conversationTwos      Conversation[] @relation("conversationTwo")
  sentMessages          Message[]      @relation("sentMessages")
  deletedMessages       Message[]      @relation("messageDeleter")
  hiddenMessages        MessageHide[]
  hiddenConversations   ConversationHidden[]
  notificationsReceived Notification[] @relation("notificationsReceived")
  notificationsSent     Notification[] @relation("notificationsSent")

  xpTransactions    XpTransaction[]
  coinTransactions  CoinTransaction[]
  userCoins         MatrixCoin?
  userAchievements  UserAchievement[]
  userBadges        UserBadge[]
  userItems         UserItem[]
  equippedItems     EquippedItem[]
  eventParticipants EventParticipant[]
  playlists         Playlist[]
  gameSessions      GameSession[]
  musicVotes        MusicVote[]

  recentSearchesOwned  RecentSearch[] @relation("recentSearchOwned")
  recentSearchesTarget RecentSearch[] @relation("recentSearchTarget")

  @@index([nickname])
  @@map("users")
}

// ── Search recents (visited profiles) ─────────────────────
// "Pesquisas recentes" — one row per (owner, target) pair, newest
// visit wins. Owned by the VISITOR (viewer); the server resolves the target's
// display identity at record time so the preview matches the user's current
// nickname/cosmetics even if the profile later changes its name.

model RecentSearch {
  id            String    @id @default(cuid())
  // The AUTHENTICATED user who visited the profile (never client-supplied).
  ownerId      String
  // The profile that was visited (a real user; deleted users cascade out).
  // Display identity (nickname/avatar/cosmetics)is resolved via the
  // target relation at read time — always the target's CURRENT identity.

  targetUserId String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner      User @relation("recentSearchOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  target     User @relation("recentSearchTarget", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@unique([ownerId, targetUserId])
  @@index([ownerId, createdAt])
  @@map("recent_searches")
}

model Post {
  id        String   @id @default(cuid())
  userId    String
  text      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  likes    Like[]
  comments Comment[]

  @@index([userId])
  @@index([createdAt])
  @@map("posts")
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
  @@map("likes")
}

model Comment {
  id        String   @id @default(cuid())
  userId    String
  postId    String
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Non-null → this comment is a REPLY to another comment on the same post.
  // null → a top-level comment. Replies are one level deep (server enforces
  // that a reply's parent is always a top-level comment).
  parentCommentId String?

  // Soft-delete marker. A comment is DELETED (hidden everywhere) when the
  // post author OR the comment owner removes it. We keep the row for audit
  // and cascade references; all read paths filter on `deletedAt: null`.
  // Deleting a top-level comment also soft-deletes its replies.
  deletedAt DateTime?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post         Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  parent       Comment?      @relation("commentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies      Comment[]     @relation("commentReplies")
  commentLikes CommentLike[]

  @@index([postId])
  @@index([userId])
  @@index([deletedAt])
  @@index([parentCommentId])
  @@index([parentCommentId, createdAt])
  @@map("comments")
}

// Like on a comment/reply. Unique per (user, comment) — same semantics as
// post likes but independent of them. Deleting a comment cascades its likes.
model CommentLike {
  id        String   @id @default(cuid())
  userId    String
  commentId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
  @@map("comment_likes")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// Push notification device tokens. One row per device/install; the token is
// unique globally and bound to a user so the push dispatcher can resolve
// "which devices belong to recipient X" without ever treating a token as an
// identity. Platform is free-form ("android", "ios") for future clients.
model Device {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("android")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("devices")
}

// ── Social: friend requests, friendships & notifications ──────
// FriendRequest tracks the pending/accepted/rejected lifecycle. The pair
// (senderId, receiverId) is unique, so duplicate requests are impossible.
// On REJECT the row is deleted (allowing a future retry); on ACCEPT a
// Friendship row is created.

model FriendRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  // PENDING | ACCEPTED | REJECTED (plain string — SQLite has no enums).
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  sender   User @relation("sentFriendRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receivedFriendRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  notifications Notification[]

  @@unique([senderId, receiverId])
  @@index([receiverId, status])
  @@map("friend_requests")
}

// Friendship stores a single unordered pair (ids sorted at insert) so
// A→B and B→A never duplicate. The relation is mutual by construction.
model Friendship {
  id        String   @id @default(cuid())
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())

  userOne User @relation("friendshipOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo User @relation("friendshipTwo", fields: [userTwoId], references: [id], onDelete: Cascade)

  @@unique([userOneId, userTwoId])
  @@map("friendships")
}

// Notifications are persistent (SQLite) and always scoped to their
// recipient. postId/commentId/friendRequestId point at the related entity
// when relevant, otherwise stay null.
model Notification {
  id              String   @id @default(cuid())
  recipientId     String
  actorId         String
  // LIKE | COMMENT | FRIEND_REQUEST | FRIEND_ACCEPTED (extensible).
  type            String
  postId          String?
  commentId       String?
  friendRequestId String?
  read            Boolean  @default(false)
  createdAt       DateTime @default(now())

  recipient     User           @relation("notificationsReceived", fields: [recipientId], references: [id], onDelete: Cascade)
  actor         User           @relation("notificationsSent", fields: [actorId], references: [id], onDelete: Cascade)
  friendRequest FriendRequest? @relation(fields: [friendRequestId], references: [id], onDelete: Cascade)

  @@index([recipientId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ── Private chat ─────────────────────────────────────────────
// One private conversation per user PAIR (ids sorted at insert, exactly like
// Friendship) so A→B and B→A never duplicate. Messaging is allowed ONLY
// between accepted friends (validated server-side on every send).
//
// Chat is prepared for realtime/unread without Firebase: messages carry
// `readAt` (null until the recipient opens/reads the conversation) so the
// "non lidas" badge can be derived per recipient without extra polling. The
// transport for live delivery reuses the server's existing WebSocket hub.

model Conversation {
  id        String   @id @default(cuid())
  // Sorted pair (userOneId < userTwoId) — one row per pair, never two.
  userOneId String
  userTwoId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userOne  User      @relation("conversationOne", fields: [userOneId], references: [id], onDelete: Cascade)
  userTwo  User      @relation("conversationTwo", fields: [userTwoId], references: [id], onDelete: Cascade)
  messages Message[]
  hiddenBy ConversationHidden[]

  @@unique([userOneId, userTwoId])
  @@index([userOneId, updatedAt])
  @@index([userTwoId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  // The sender is ALWAYS the authenticated user — never client-supplied.
  senderId       String
  // The message text. For VOICE messages this is the transcription/empty
  // label ("🎤 Áudio" is the literal stored content the app renders); for
  // text messages it is the actual content. Kept non-null for historical
  // compatibility — voice messages store a stable preview string here.
  content        String
  createdAt      DateTime  @default(now())
  // Set when the recipient marks the conversation read; null = not yet read
  // by the other side. Not per-message read receipts — just enough for the
  // "non lidas" badge (count messages where the other side hasn't read).
  readAt         DateTime?
  // Reply support: when replying, the id of the SAME-conversation message
  // being answered. Only the reference is stored (never the original
  // content); the server resolves the preview at load time and degrades
  // gracefully if the original is gone.
  replyToMessageId String?
  // NULL → text message. Non-null → a voice message: `type` is "voice",
  // `content` holds "🎤 Áudio", `audioUrl` points at the persisted file and
  // `durationMs` is the recorded length (3–60s, validated server-side).
  type         String?
  audioUrl     String?
  durationMs   Int?

  // Soft-delete marker for "Excluir para todos". When set, the message is
  // hidden for BOTH participants (all read paths filter it out). The row + a
  // snapshot of the original content are kept for audit and so replies that
  // point at this message still resolve a `exists:false` placeholder.
  // `deletedById` records WHO deleted it (always the sender or a valid peer).
  deletedAt    DateTime?
  deletedById  String?

  // Per-user "Excluir para mim": each participant can hide the message for
  // themselves only (the peer keeps seeing it). One-to-many join rows.
  hiddenBy     MessageHide[]

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("sentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("messageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("messageReplies")
  deleter      User?        @relation("messageDeleter", fields: [deletedById], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([senderId])
  @@index([readAt])
  @@index([replyToMessageId])
  @@index([deletedAt])
  @@map("messages")
}

// "Excluir mensagem para mim" — a viewer-specific soft-delete. Each row says
// "this message is hidden for THIS user (but still visible to the peer)".
model MessageHide {
  id             String   @id @default(cuid())
  messageId      String
  userId         String
  createdAt      DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_hides")
}

// "Excluir conversa (só para mim)" — hides a conversation from ONE user's
// Chat list. The conversation row and its messages stay fully intact for the
// peer. A NEW incoming message to that user un-hides it (their conversation
// reappears, matching normal chat behavior).
model ConversationHidden {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
  @@map("conversation_hidden")
}

// ── Gamification ─────────────────────────────────────────────
// Append-only ledger of every XP change. Never mutate a single `xp`
// counter directly — always insert a transaction so the full history is
// auditable and the current total is `SUM(amount)`.

model XpTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  reason    String
  source    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("xp_transactions")
}

model Level {
  id        Int      @id
  name      String
  minXp     Int      @unique
  color     String?
  createdAt DateTime @default(now())

  @@map("levels")
}

model MatrixCoin {
  userId    String   @id
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("matrix_coins")
}

// Append-only ledger of every Matrix Coin movement. The balance is the
// `SUM(amount)` of all transactions for a user.
model CoinTransaction {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  type      String
  reason    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("coin_transactions")
}

// ── Achievements & Badges ─────────────────────────────────────

model Achievement {
  id          String   @id
  name        String
  description String
  xpReward    Int      @default(0)
  coinReward  Int      @default(0)
  iconUrl     String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model Badge {
  id          String   @id
  name        String
  description String
  iconUrl     String?
  rarity      String   @default("COMMON")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id         String   @id @default(cuid())
  userId     String
  badgeId    String
  acquiredAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

// ── Customization (Personalization Engine) ────────────────────
// The server owns the catalog. The APK only knows how to render a given
// ItemType; adding items is a data operation, not an APK release.

model Item {
  id        String   @id
  type      String
  name      String
  // For NAME_COLOR items this holds the hex color (e.g. "#0066FF") instead
  // of an asset path — the "asset" of a color IS the color value.
  assetUrl  String
  rarity    String   @default("COMMON")
  price     Int      @default(0)
  // Optional grouping key for the catalog UI (e.g. "reds", "special").
  // Owned by the server so the app never hardcodes which colors exist.
  category  String?
  // Explicit ordering inside a category (catalogs are curated, not
  // alphabetical).
  sortOrder Int      @default(0)
  // JSON-serialized render configuration (SQLite has no Json type). Kept
  // generic for future cosmetic types that need extra render data.
  config    String   @default("{}")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userItems     UserItem[]
  equippedItems EquippedItem[]

  @@index([type])
  @@map("items")
}

model UserItem {
  id         String    @id @default(cuid())
  userId     String
  itemId     String
  quantity   Int       @default(1)
  acquiredAt DateTime  @default(now())
  expiresAt  DateTime?
  source     String    @default("GRANT")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("user_items")
}

model EquippedItem {
  id         String   @id @default(cuid())
  userId     String
  itemId     String
  slot       String
  equippedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, slot])
  @@index([userId])
  @@map("equipped_items")
}

// ── Events ─────────────────────────────────────────────────────

model Event {
  id          String    @id @default(cuid())
  title       String
  description String    @default("")
  status      String    @default("DRAFT")
  startsAt    DateTime
  endsAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  participants EventParticipant[]
  rewards      EventReward[]

  @@index([status])
  @@map("events")
}

model EventParticipant {
  id       String   @id @default(cuid())
  userId   String
  eventId  String
  joinedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("event_participants")
}

model EventReward {
  id         String   @id @default(cuid())
  eventId    String
  itemId     String?
  xpAmount   Int      @default(0)
  coinAmount Int      @default(0)
  createdAt  DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_rewards")
}

// ── Matrix Music ──────────────────────────────────────────────
// No commercial audio is stored. Tracks reference an external provider
// (e.g. a licensed streaming API) via provider + externalId/externalUrl.

model Track {
  id          String   @id @default(cuid())
  title       String
  artist      String
  coverUrl    String?
  provider    String   @default("external")
  externalId  String?
  externalUrl String?
  duration    Int      @default(0)
  createdAt   DateTime @default(now())

  playlistTracks PlaylistTrack[]
  votes          MusicVote[]

  @@index([provider])
  @@map("tracks")
}

model Playlist {
  id          String   @id @default(cuid())
  ownerId     String
  title       String
  description String   @default("")
  coverUrl    String?
  visibility  String   @default("public")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  playlistTracks PlaylistTrack[]

  @@index([ownerId])
  @@map("playlists")
}

model PlaylistTrack {
  id         String @id @default(cuid())
  playlistId String
  trackId    String
  position   Int

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track    Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([playlistId, trackId])
  @@index([playlistId])
  @@map("playlist_tracks")
}

model MusicVote {
  id        String   @id @default(cuid())
  userId    String
  trackId   String
  direction String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  track Track @relation(fields: [trackId], references: [id], onDelete: Cascade)

  @@unique([userId, trackId])
  @@index([trackId])
  @@map("music_votes")
}

// ── Games ─────────────────────────────────────────────────────
// Rewards are validated server-side: a GameResult records the outcome but
// the server decides the payout. The client can never mint coins by itself.

model Game {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String   @default("")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  sessions GameSession[]

  @@map("games")
}

model GameSession {
  id        String   @id @default(cuid())
  userId    String
  gameId    String
  score     Int      @default(0)
  metadata  String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  result GameResult?

  @@index([userId])
  @@index([gameId])
  @@map("game_sessions")
}

model GameResult {
  id            String   @id @default(cuid())
  gameSessionId String   @unique
  xpAwarded     Int      @default(0)
  coinAwarded   Int      @default(0)
  createdAt     DateTime @default(now())

  session GameSession @relation(fields: [gameSessionId], references: [id], onDelete: Cascade)

  @@map("game_results")
}

// ── Matrix Calls (contracts only — no media transport yet) ─────

model CallRoom {
  id        String    @id @default(cuid())
  ownerId   String
  title     String
  status    String    @default("active")
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  @@map("call_rooms")
}

model CallParticipant {
  id       String    @id @default(cuid())
  roomId   String
  userId   String
  status   String    @default("joined")
  joinedAt DateTime  @default(now())
  leftAt   DateTime?

  @@unique([roomId, userId])
  @@index([roomId])
  @@map("call_participants")
}

// ── Dynamic configuration ─────────────────────────────────────
// Key/value store the app reads at startup to toggle features, announce
// maintenance, or push personalizations without an APK update.

model AppConfig {
  key       String   @id
  value     String   @default("{}")
  public    Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("app_config")
}
