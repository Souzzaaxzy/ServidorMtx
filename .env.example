# ──────────────────────────────────────────────────────────────
# MATRIX API — environment variables (documentation only)
#
# This file documents the variables the server reads from process.env.
# It is NOT required to run the server — on a Pterodactyl/Bronxys panel
# you set the same variables directly in the panel's "Variables" tab.
#
# For local dev you may copy this file to .env and edit it.
# NEVER commit your real .env file.
# ──────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────
# PORT — NÃO configurar em produção. A Pterodactyl/Bronxys injeta a porta
# alocada automaticamente (PORT ou SERVER_PORT) e a API usa esse valor.
# Descomente APENAS para desenvolvimento local:
# PORT=3000
# PUBLIC_API_URL — endereço público REAL da API, usado pelo APK (MatrixApp).
# A Pterodactyl/Bronxys NÃO injeta um hostname público: o endereço é o
# IP/host público do node + a porta alocada, visível na página do servidor
# no painel (seção de alocação/network). Exemplos do formato esperado:
#   PUBLIC_API_URL=http://IP-DO-NODE:PORTA-ALOCADA
#   PUBLIC_API_URL=http://node-exemplo.bronxys.cloud:4316
# Use HTTPS somente se o painel fornecer um domínio/proxy com SSL válido —
# nunca invente HTTPS para um IP+porta. Sem barra final.
# O MESMO valor deve ser configurado no MatrixApp (API_BASE_URL).
PUBLIC_API_URL=
# Comma-separated list of allowed CORS origins (Flutter app origin, etc.)
# Use "*" only for development. Production should list explicit origins.
CORS_ORIGIN=
# Node environment
NODE_ENV=production
# pino log level (debug/info/warn/error). Defaults to debug in dev, info in prod.
LOG_LEVEL=info

# ── Database (SQLite — local file, no external DB required) ───
# The database is a local SQLite file at data/matrix.db, created
# automatically on first boot. NENHUMA variável é necessária para o banco:
# NÃO configure DATABASE_URL (SQLite não usa connection string externa) e
# nenhum PostgreSQL/MySQL é necessário.

# ── Auth / JWT ───────────────────────────────────────────────
# Secret usado para assinar os tokens de acesso. Recomendado definir uma
# string longa e aleatória (gere com: openssl rand -hex 32), no painel da
# Pterodactyl/Bronxys (Variables) ou aqui em dev.
# FALLBACK AUTOMÁTICO: se esta variável estiver vazia/ausente, o start.sh
# gera UM segredo persistente em data/.jwt_secret (chmod 600, gitignored,
# nunca regenerado) — a API sobe sem configuração manual e os tokens não
# são invalidados entre reinícios.
JWT_SECRET=CHANGE_ME
# Access token lifetime (e.g. "15m", "1h")
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (e.g. "30d", "7d")
JWT_REFRESH_EXPIRES_IN=30d

# ── AI (Akame) ───────────────────────────────────────────────
# Leave AI_API_KEY empty to use the mock provider (no external calls).
# Set AI_PROVIDER=openai|anthropic and provide a key to use a real provider.
AI_API_KEY=
AI_PROVIDER=mock
# OpenAI-compatible base URL (only used when AI_PROVIDER=openai).
# Override for Azure/OpenRouter/self-hosted endpoints; otherwise defaults to
# https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
# Model identifier for the selected provider (e.g. gpt-4o-mini,
# claude-3-5-sonnet-20241022). Ignored by the mock provider.
AI_MODEL=gpt-4o-mini

# ── Storage (object storage for uploads) ─────────────────────
# If STORAGE_ENDPOINT is empty, the API uses local filesystem storage
# (files saved to server/uploads and served at /static) — no external
# service required. For production, configure an S3-compatible provider
# (AWS S3, Cloudflare R2, Supabase Storage, MinIO, etc.).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=matrix-uploads
# S3 region (ignored for local storage)
STORAGE_REGION=auto
# Whether the storage endpoint uses path-style addressing (true for R2/MinIO)
STORAGE_FORCE_PATH_STYLE=true
# Public base URL used to build file URLs returned to the client.
# For local storage leave empty (defaults to http://HOST:PORT/static).
STORAGE_PUBLIC_BASE_URL=

# ── Limits ───────────────────────────────────────────────────
# Max upload size in bytes (default 5MB)
MAX_UPLOAD_BYTES=5242880

# ── Profile music (YouTube via yt-dlp) ───────────────────────
# The profile song feature searches YouTube Music and downloads a short
# excerpt (max 1 minute) on the SERVER. It needs two external programs on
# the host:
#   * yt-dlp  — the search/download engine
#   * ffmpeg  — required to cut the excerpt (yt-dlp aborts without it)
# Install: `pip install yt-dlp` + `apt install ffmpeg` (or `pkg install
# yt-dlp ffmpeg` on Termux, `apk add yt-dlp ffmpeg` on Alpine).
# Path to the yt-dlp executable. Leave empty to auto-detect (`yt-dlp` on
# PATH, then `python3 -m yt_dlp`). Set it when the binary lives elsewhere.
YT_DLP_PATH=

# YouTube cookies — this is what LIFTS the anti-bot block ("Sign in to
# confirm you're not a bot") that datacenter/VPS IPs get.
#
# EASIEST PATH (no variable at all): export cookies.txt from a browser where
# you are logged into YouTube (an extension that writes Netscape format, e.g.
# "Get cookies.txt LOCALLY") and COPY THE FILE to data/cookies.txt on the
# server. The server finds it automatically, passes it to yt-dlp and restricts
# its permissions to 600 on boot. data/ is the same persistent directory as
# matrix.db, so the file survives restarts and redeploys.
#
# Only if you cannot drop the file in data/, paste the content here as BASE64
# so the value stays a single line:
#   base64 -w0 cookies.txt          (Linux)
#   base64 -i cookies.txt          (macOS)
# The server writes a temporary, chmod-600 jar per run and DELETES it right
# after, so the credential never lingers on disk.
# A cookie jar is a CREDENTIAL: treat it like a password. Use a throwaway
# account if you prefer, and rotate it if it ever leaks.
YT_COOKIES=
# Alternative to YT_COOKIES: a path to a cookies.txt file on the server.
# YT_COOKIES wins when both are set; the data/cookies.txt drop-in is used
# only when neither YT_COOKIES nor YT_COOKIES_FILE is set.
YT_COOKIES_FILE=
# JavaScript runtime for yt-dlp. The YouTube requires one and yt-dlp enables
# ONLY `deno` by default — on a Node host (Termux!) deno is usually missing
# while Node is right there, so the server falls back to its own Node binary.
# Override only if you need a specific runtime, e.g. `deno` or
# `node:/usr/bin/node` (or `bun`).
YT_JS_RUNTIME=
# Remote components for yt-dlp — OPT-IN and OFF by default, because this lets
# yt-dlp DOWNLOAD AND EXECUTE third-party JavaScript fetched at runtime.
# Preferred safe path: install the package (`pip install yt-dlp-ejs`).
# Enable only if you understand and accept that risk, e.g. `ejs:github`.
YT_REMOTE_COMPONENTS=
# Path to the ffmpeg binary (or its directory). Leave empty to auto-detect
# (PATH, $PREFIX/bin, the Termux prefix, /usr/bin, Homebrew). The server also
# passes it to yt-dlp via --ffmpeg-location, so a ffmpeg that is installed but
# NOT on the process PATH is still found.
FFMPEG_PATH=
# Set to 1 to SKIP ffmpeg entirely. The server then stores the whole track
# (m4a format 140, no conversion needed) and the app plays only the chosen
# window. Useful when ffmpeg is broken/partially installed (common on Termux,
# where it pulls ~50 packages) — the feature keeps working, just with a bigger
# file. Leave empty to prefer the smaller, ffmpeg-cut excerpt.
YT_NO_FFMPEG=
