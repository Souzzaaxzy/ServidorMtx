# ──────────────────────────────────────────────────────────────
# MATRIX API — environment variables (copy to .env and fill in)
# NEVER commit your real .env file. This file documents the schema.
#
# Used by: docker-compose.yml, npm run dev, npm test
# ──────────────────────────────────────────────────────────────

# ── docker-compose host ports ────────────────────────────────
API_PORT=3000
DB_PORT=5432

# ── PostgreSQL (compose creates the db with these) ───────────
POSTGRES_USER=matrix
POSTGRES_PASSWORD=matrix
POSTGRES_DB=matrix

# ── Server ───────────────────────────────────────────────────
PORT=3000
# Allocated port injected by the panel (e.g. Pterodactyl). PORT takes
# priority when set; SERVER_PORT is used as a fallback so the panel works
# out of the box without extra configuration.
SERVER_PORT=3000
# Comma-separated list of allowed CORS origins (Flutter app origin, etc.)
# Use "*" only for development. Production should list explicit origins.
CORS_ORIGIN=*
# Node environment
NODE_ENV=development
# pino log level (debug/info/warn/error). Defaults to debug in dev, info in prod.
LOG_LEVEL=debug

# ── Database (PostgreSQL) ─────────────────────────────────────
# When using docker-compose, the host is "db" (service name).
# When running locally with a host Postgres, use 127.0.0.1 (prefer it over
# "localhost" — "localhost" may resolve to IPv6 ::1 first, which Docker does
# not bind, causing "Can't reach database server" errors).
DATABASE_URL=postgresql://matrix:matrix@127.0.0.1:5432/matrix?schema=public

# ── Auth / JWT ───────────────────────────────────────────────
# Secret used to sign access tokens. MUST be a long random string in prod.
JWT_SECRET=change-me-to-a-long-random-secret
# Access token lifetime (e.g. "15m", "1h")
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token lifetime (e.g. "30d", "7d")
JWT_REFRESH_EXPIRES_IN=30d

# ── AI (Akame) ───────────────────────────────────────────────
# Leave AI_API_KEY empty to use the mock provider (no external calls).
# Set AI_PROVIDER=openai|anthropic and provide a key to use a real provider.
AI_API_KEY=
AI_PROVIDER=mock
# OpenAI-compatible base URL (only used when AI_PROVIDER=openai).
# Override for Azure/OpenRouter/self-hosted endpoints; otherwise defaults to
# https://api.openai.com/v1
AI_BASE_URL=https://api.openai.com/v1
# Model identifier for the selected provider (e.g. gpt-4o-mini,
# claude-3-5-sonnet-20241022). Ignored by the mock provider.
AI_MODEL=gpt-4o-mini

# ── Storage (object storage for uploads) ─────────────────────
# If STORAGE_ENDPOINT is empty, the API uses local filesystem storage
# (files saved to server/uploads and served at /static) — no external
# service required. For production, configure an S3-compatible provider
# (AWS S3, Cloudflare R2, Supabase Storage, MinIO, etc.).
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_BUCKET=matrix-uploads
# S3 region (ignored for local storage)
STORAGE_REGION=auto
# Whether the storage endpoint uses path-style addressing (true for R2/MinIO)
STORAGE_FORCE_PATH_STYLE=true
# Public base URL used to build file URLs returned to the client.
# For local storage leave empty (defaults to http://HOST:PORT/static).
STORAGE_PUBLIC_BASE_URL=

# ── Limits ───────────────────────────────────────────────────
# Max upload size in bytes (default 5MB)
MAX_UPLOAD_BYTES=5242880
